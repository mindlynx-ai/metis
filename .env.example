# Copy this to .env and edit. Metis reads it automatically, on every platform,
# so you never need `export` (bash) or `$env:` (PowerShell) to run a command.
#
# A real environment variable beats this file, so you can still override any
# single value for one command without editing anything.
#
# .env is git-ignored. Do not commit real secrets.

# REQUIRED. Metis refuses to serve on its published default, which is printed in
# this repository and therefore not a secret at all. Pick your own.
METIS_ADMIN_SECRET=change-me

# Attach to a Temporal you already run instead of Metis downloading and managing
# its own. Leave unset and Metis handles it for you.
# METIS_TEMPORAL_ADDRESS=127.0.0.1:7233

# Where to listen. Loopback by default; 0.0.0.0 deliberately serves other
# machines on your network, and prints a warning when it does.
# METIS_HOST=127.0.0.1

# Postgres instead of the default SQLite.
# METIS_DATASTORE=postgres
# PG_URL=postgres://user:password@localhost:5432/metis

# Run Python code steps with a real CPython. Unset means the Python language is
# refused. Read the code node docs first: unlike JavaScript, Python is NOT
# sandboxed and can reach your disk and network.
# METIS_PYTHON=auto

# fastify log level: fatal|error|warn|info|debug|trace
# METIS_LOG_LEVEL=warn
