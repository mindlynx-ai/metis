# Automatic HTTPS for the Metis demo. Caddy fetches and renews a Let's Encrypt
# certificate for METIS_DEMO_HOST, then reverse-proxies everything (including the
# run-status WebSocket, which Caddy upgrades transparently) to the Metis app.
{$METIS_DEMO_HOST} {
	encode zstd gzip
	header {
		# Ordinary hardening, and the absence of it is itself a signal: a young
		# domain serving a sign-in page with no security headers scores badly
		# with reputation scanners, on top of being worse for the people using it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No Content-Security-Policy yet. The editor is a bundled SPA with an
		# inline theme script in index.html, so a policy tight enough to be worth
		# having needs a nonce or a hash and a browser pass to prove nothing
		# breaks. Shipping a permissive one to look compliant would be theatre.
	}
	reverse_proxy metis:3000
}

# Other hostnames that resolve to this box and should land on the canonical
# host. Space separated, e.g. "example.com www.example.com".
#
# Only list names whose DNS ALREADY points here. Caddy obtains a certificate for
# every site block, so a name with no A record fails the ACME challenge and
# retries for the full 30-day window before falling back to the staging CA. A
# www -> apex redirect used to sit here unconditionally and did exactly that.
#
# Leaving a name OFF this list when it does resolve here is the other failure,
# and the louder one: Caddy has no certificate to present, so the handshake dies
# with an internal-error alert and the browser says ERR_SSL_PROTOCOL_ERROR. A
# domain pointed at this box is either served or it is broken; there is no third
# state.
#
# The default is a .localhost name on purpose: Caddy issues those from its
# internal CA and never asks an ACME server for one, so an unset variable costs
# nothing.
{$METIS_REDIRECT_HOSTS:metis-redirect.localhost} {
	redir https://{$METIS_DEMO_HOST}{uri} permanent
}

# The marketing site, served as static files from a directory mounted at
# /srv/site. This is what the apex domain answers with; the app keeps
# METIS_DEMO_HOST to itself.
#
# The apex used to sit in METIS_REDIRECT_HOSTS above, which meant anyone who
# typed the bare domain landed on a sign-in form. Serving it here rather than
# moving its DNS elsewhere is deliberate: the box already holds a valid
# certificate for the name, so nothing has to be re-issued and the ACME failure
# mode described above never comes up.
#
# Same .localhost default and the same rule as the redirect block: only set this
# to a name whose DNS already points at this box. With no site directory mounted
# the block still answers, with a 404 from file_server, which is a clearer
# failure than a dead handshake.
{$METIS_SITE_HOST:metis-site.localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A static page with no inline script and no third-party origin can hold
		# a real policy, unlike the editor above. Keep it that way: if the site
		# ever needs inline script, hash it rather than widening this.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	root * /srv/site
	file_server
}

# www -> the apex site. Separate from METIS_REDIRECT_HOSTS because that block
# sends everything to the app, and www belongs with the page a visitor asked
# for, not with the sign-in form.
{$METIS_SITE_WWW_HOST:metis-site-www.localhost} {
	redir https://{$METIS_SITE_HOST}{uri} permanent
}
