node_modules/
dist/
coverage/
.metis/
*.local.md
.env
# Except gate 4's planted violation: a fake key that has to be tracked, or the
# test proving .env is scanned only passes on the machine that wrote it.
!gates/fixtures/violations/gate-4/.env
test-results/
playwright-report/

# AWS demo box: local-only secrets, state and private key
deploy/aws*/.env
deploy/aws*/.state
deploy/aws*/*.pem
# ...and their timestamped backups. `deploy/aws*/.env` does NOT match
# `.env.bak.1786037594`, so a rotation backup carrying METIS_ADMIN_SECRET /
# METIS_DEMO_SECRET sat untracked-but-committable in the working tree.
# Kept narrow (.bak/.backup/.save only) so `.env.example` and `.env.template`
# stay trackable everywhere without needing a negation.
.env.bak*
.env.backup*
.env.save*
deploy/aws*/.env.bak*

# Internal planning/porting notes: never ship in the public repo.
docs/internal/

# MkDocs build output (docs.metisflow.io is built in CI)
site/

